---
import { BASE, BLOG_URL } from '../../site.config.mjs';
---

<footer class="hud-footer" role="contentinfo">
  <div class="wrap hud-footer__inner">
    <div class="hud-footer__col">
      <div class="hud-footer__logo f-display">LOGKISM</div>
      <p class="hud-footer__desc f-mono">
        MISSION CONTROL // SEC-OPS R&D<br />
        Offensive Security · Aerospace Telemetry · Reverse Engineering
      </p>
      <div class="hud-footer__badge">
        <span class="dot"></span>
        <span class="micro">SYSTEMS OPERATIONAL // ALL SECTORS GREEN</span>
      </div>
    </div>

    <div class="hud-footer__col">
      <div class="micro footer-tag">COMMUNICATION ARRAYS</div>
      <ul class="footer-links f-mono">
        <li><a href="https://github.com/logkism" target="_blank" rel="noopener" class="link-slash" data-cursor="EXTERNAL">GH // github.com/logkism</a></li>
        <li><a href="https://twitter.com/logkism" target="_blank" rel="noopener" class="link-slash" data-cursor="EXTERNAL">X // @logkism</a></li>
        <li><a href="https://linkedin.com" target="_blank" rel="noopener" class="link-slash" data-cursor="EXTERNAL">IN // linkedin.com/in/logkism</a></li>
        <li><a href="mailto:contact@logkism.io" class="link-slash" data-cursor="SIGNAL">MAIL // contact@logkism.io</a></li>
      </ul>
    </div>

    <div class="hud-footer__col">
      <div class="micro footer-tag">SOOLOGNZ BLOG</div>
      <p class="footer-note f-mono">
        Truy cập trang blog <a href={BLOG_URL} class="link-slash">SOOLOGNZ</a> để đọc các bài phân tích CTF write-ups, firmware exploits và aerospace telemetry research.
      </p>
    </div>
  </div>

  <div class="hud-footer__bar wrap">
    <span class="micro">© {new Date().getFullYear()} LOGKISM. ALL RIGHTS RESERVED. DEFENSE_GRADE_PORTFOLIO.</span>
    <span class="micro">LATENCY: 12ms · ENCRYPTION: CHACHA20-POLY1305</span>
  </div>
</footer>

<style>
  .hud-footer {
    position: relative;
    border-top: 1px solid var(--line-accent);
    background: linear-gradient(180deg, rgba(7, 7, 10, 0.4), rgba(7, 7, 10, 0.95));
    padding-top: clamp(4rem, 8vh, 6rem);
    padding-bottom: 2rem;
    z-index: 10;
  }
  .hud-footer__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr;
    gap: clamp(2rem, 5vw, 4rem);
    margin-bottom: 4rem;
  }
  @media (max-width: 860px) {
    .hud-footer__inner {
      grid-template-columns: 1fr;
    }
  }
  .hud-footer__logo {
    font-size: 1.8rem;
    letter-spacing: 0.15em;
    color: var(--accent-hi);
    margin-bottom: 1rem;
  }
  .hud-footer__desc {
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 1.5rem;
    font-size: var(--fs-xs);
  }
  .hud-footer__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.8rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
  }
  .footer-tag {
    color: var(--accent-hi);
    margin-bottom: 1.2rem;
    display: block;
  }
  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    font-size: var(--fs-xs);
  }
  .footer-note {
    color: var(--muted);
    font-size: var(--fs-xs);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .hud-footer__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
