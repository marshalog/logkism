---
import BaseLayout from '../layouts/BaseLayout.astro';
import HudNavbar from '../components/HudNavbar.astro';
import HudFooter from '../components/HudFooter.astro';
import { BLOG_URL } from '../../site.config.mjs';
---

<BaseLayout title="LOGKISM // MISSION CONTROL" description="Portfolio cá nhân phong cách Aerospace × Cybersecurity hiện đại, dark crimson aesthetic kết hợp Tu Tiên mode.">
  <HudNavbar current="home" />

  <main id="main-content">
    <!-- HERO SECTION -->
    <section class="hero section wrap" id="hero">
      <div class="hero__badge" data-reveal="0.1">
        <span class="dot"></span>
        <span class="micro t-cyber">DEFENSE SYSTEM // CLASSIFIED TIER-1 PROTOCOL</span>
        <span class="micro t-xian cjk">太虛神念 · 劍氣沖霄</span>
      </div>

      <h1 class="hero__title f-display" data-split="chars">
        <span class="hero__line">AEROSPACE</span><br />
        <span class="hero__line outline-text">CYBERSEC</span><br />
        <span class="hero__line accent">LOGKISM</span>
      </h1>

      <p class="hero__lead f-head" data-reveal="0.3">
        Kỹ sư nghiên cứu bảo mật hệ thống hàng không vũ trụ & vi điều khiển nhúng.<br />
        Chuyên sâu Red Teaming vệ tinh, reverse engineering firmware bay và kiến trúc phòng thủ mạng kiên cố.
      </p>

      <div class="hero__actions" data-reveal="0.45">
        <a href="#missions" class="btn btn--primary" data-cursor="EXPLORE">
          <span class="btn__tab"></span>
          <span class="btn__fill"></span>
          <span class="btn__label t-cyber">INITIALIZE RADAR // DỰ ÁN</span>
          <span class="btn__label t-xian cjk">Chiêm Ngưỡng Chiến Tích</span>
          <span class="btn__icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 3v10M3 8l5 5 5-5"/>
            </svg>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 3v10M3 8l5 5 5-5"/>
            </svg>
          </span>
        </a>

        <a href={BLOG_URL} class="btn btn--ghost" data-warp="BLACKBOX // INTEL LOG" data-cursor="WARP">
          <span class="btn__tab"></span>
          <span class="btn__fill"></span>
          <span class="btn__label t-cyber">JUMP TO BLOG [BLACKBOX] ↗</span>
          <span class="btn__label t-xian cjk">Vào Tàng Kinh Các ↗</span>
        </a>
      </div>

      <!-- Quick Telemetry HUD stats -->
      <div class="hero__hud-panel panel brackets" data-reveal="0.6">
        <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
        <div class="hero__metric">
          <span class="micro">ORBITAL MISSIONS</span>
          <span class="f-display hero__val" data-count="38" data-pad="2">00</span>
          <span class="micro text-ok">// ALL COMPLETED</span>
        </div>
        <div class="hero__metric">
          <span class="micro">VULNERABILITIES REPORTED</span>
          <span class="f-display hero__val" data-count="147" data-pad="3">000</span>
          <span class="micro text-accent">// CRITICAL ZERO-DAYS</span>
        </div>
        <div class="hero__metric">
          <span class="micro">FLIGHT HOURS & LOGS</span>
          <span class="f-display hero__val" data-count="4200">0000</span>
          <span class="micro text-ok">// TELEMETRY VALID</span>
        </div>
        <div class="hero__metric">
          <span class="micro">GLOBAL CTF RANKING</span>
          <span class="f-display hero__val">TOP 1%</span>
          <span class="micro text-accent">// AEROSPACE SECTOR</span>
        </div>
      </div>
    </section>

    <!-- SECTION 01: DOSSIER -->
    <section class="section wrap" id="dossier">
      <div class="sec-head">
        <span class="sec-head__idx">01 //</span>
        <div class="sec-head__rule"></div>
        <span class="sec-head__tag t-cyber">PROFILE & RECON</span>
        <span class="sec-head__tag t-xian cjk">Căn Cốt Bản Mệnh</span>
      </div>

      <h2 class="sec-title">
        IDENTITY // <em>DOSSIER</em>
      </h2>

      <div class="dossier-grid">
        <div class="dossier-card panel brackets" data-reveal="0.1">
          <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
          <span class="micro accent">PERSONNEL FILE // CLASSIFIED</span>
          <h3 class="f-head dossier-name">LOGKISM</h3>
          <p class="f-mono text-muted">
            Hoạt động tại giao điểm giữa phần cứng hàng không vũ trụ và an ninh mạng chuyên sâu. Đam mê khai thác lỗ hổng trong các giao thức truyền thông vệ tinh không gian sâu (CCSDS, DVB-S2) và bảo mật vi điều khiển bay UAV/CubeSat.
          </p>
          <div class="redacted-box">
            <span class="micro">SECRET CLEARANCE:</span>
            <span class="redacted-text" data-cursor="HOVER_TO_DECRYPT">LEVEL-5 RED TEAM EXPLOIT DEV // REVERSE ENG</span>
          </div>
        </div>

        <div class="dossier-intel panel" data-reveal="0.25">
          <div class="intel-row">
            <span class="micro">CALLSIGN</span>
            <span class="f-mono">LK-ORBITAL-01</span>
          </div>
          <div class="intel-row">
            <span class="micro">PRIMARY DOMAINS</span>
            <span class="f-mono">Aerospace Telemetry · RF Exploitation · Firmware Security</span>
          </div>
          <div class="intel-row">
            <span class="micro">SPECIALTIES</span>
            <span class="f-mono">Hardware Hacking, SDR (Software Defined Radio), Rust, C++, Ghidra</span>
          </div>
          <div class="intel-row">
            <span class="micro">CULTIVATION REALM (TU TIÊN)</span>
            <span class="f-mono accent">Đại Thừa Kỳ // Chuẩn Bị Độ Kiếp Phi Thăng</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 02: ARSENAL (SKILLS) -->
    <section class="section wrap" id="arsenal">
      <div class="sec-head">
        <span class="sec-head__idx">02 //</span>
        <div class="sec-head__rule"></div>
        <span class="sec-head__tag t-cyber">WEAPONRY & SKILLS</span>
        <span class="sec-head__tag t-xian cjk">Thần Thông Pháp Bảo</span>
      </div>

      <h2 class="sec-title">
        TECHNICAL // <em>ARSENAL</em>
      </h2>

      <div class="arsenal-grid">
        <div class="arsenal-card panel brackets" data-reveal="0.1">
          <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
          <div class="micro accent">DOMAIN 01</div>
          <h3 class="f-head arsenal-card__title">AEROSPACE & RF</h3>
          <ul class="arsenal-list f-mono">
            <li><span>GNU Radio & SDR Analysis</span><span class="accent">[98%]</span></li>
            <li><span>CCSDS Space Packet Protocol</span><span class="accent">[92%]</span></li>
            <li><span>CubeSat Subsystems & OBC</span><span class="accent">[88%]</span></li>
            <li><span>Telemetry Stream Interception</span><span class="accent">[95%]</span></li>
          </ul>
        </div>

        <div class="arsenal-card panel brackets" data-reveal="0.2">
          <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
          <div class="micro accent">DOMAIN 02</div>
          <h3 class="f-head arsenal-card__title">OFFENSIVE CYBERSEC</h3>
          <ul class="arsenal-list f-mono">
            <li><span>Firmware Reverse (Ghidra, IDA)</span><span class="accent">[96%]</span></li>
            <li><span>Kernel Exploitation (Linux/RTOS)</span><span class="accent">[91%]</span></li>
            <li><span>Memory Corruption (Heap/ROP)</span><span class="accent">[94%]</span></li>
            <li><span>Hardware JTAG/UART Glitching</span><span class="accent">[89%]</span></li>
          </ul>
        </div>

        <div class="arsenal-card panel brackets" data-reveal="0.3">
          <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
          <div class="micro accent">DOMAIN 03</div>
          <h3 class="f-head arsenal-card__title">SYSTEMS & ARCHITECTURE</h3>
          <ul class="arsenal-list f-mono">
            <li><span>Rust (Embedded / Async Tokio)</span><span class="accent">[95%]</span></li>
            <li><span>Modern C++ / Low-level ASM</span><span class="accent">[93%]</span></li>
            <li><span>RTOS (FreeRTOS, Zephyr)</span><span class="accent">[90%]</span></li>
            <li><span>High-throughput WebGL / Shaders</span><span class="accent">[87%]</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- SECTION 03: MISSIONS (PROJECTS) -->
    <section class="section wrap" id="missions">
      <div class="sec-head">
        <span class="sec-head__idx">03 //</span>
        <div class="sec-head__rule"></div>
        <span class="sec-head__tag t-cyber">DEPLOYED OPERATIONS</span>
        <span class="sec-head__tag t-xian cjk">Kỳ Trận Chiến Tích</span>
      </div>

      <h2 class="sec-title">
        MISSION // <em>ARCHIVE</em>
      </h2>

      <div class="missions-list">
        <!-- Mission 1 -->
        <article class="mission-card panel brackets" data-reveal="0.1">
          <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
          <div class="mission-card__header">
            <span class="micro accent">MISSION CODNAME: APEX-ORBIT</span>
            <span class="micro">CLASS: SPACE TELEMETRY EXPLOIT</span>
          </div>
          <h3 class="f-display mission-card__title">SATELLITE DOWNLINK SIMULATOR & FUZZER</h3>
          <p class="mission-card__desc f-mono">
            Hệ thống mô phỏng truyền tải downlink vệ tinh không gian thấp (LEO), tích hợp bộ fuzzer giao thức mã hoá để phát hiện lỗi tràn bộ đệm trong phần mềm xử lý tín hiệu mặt đất.
          </p>
          <div class="mission-card__tags f-mono">
            <span>RUST</span>
            <span>GNU RADIO</span>
            <span>AEROSPACE RF</span>
            <span>ZERO-DAY</span>
          </div>
          <div class="mission-card__footer">
            <a href="https://github.com/logkism" target="_blank" rel="noopener" class="btn btn--sm btn--ghost" data-cursor="CODE">
              <span class="btn__tab"></span>
              <span class="btn__fill"></span>
              <span class="btn__label">SOURCE REPO ↗</span>
            </a>
            <a href={BLOG_URL} class="link-slash f-mono" data-warp="BLACKBOX WRITEUP">
              <span>ĐỌC BÀI VIẾT PHÂN TÍCH KỸ THUẬT</span>
            </a>
          </div>
        </article>

        <!-- Mission 2 -->
        <article class="mission-card panel brackets" data-reveal="0.2">
          <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
          <div class="mission-card__header">
            <span class="micro accent">MISSION CODENAME: GHOST-UAV</span>
            <span class="micro">CLASS: HARDWARE REVERSE ENG</span>
          </div>
          <h3 class="f-display mission-card__title">DRONE AUTOPILOT FIRMWARE EMULATION RIG</h3>
          <p class="mission-card__desc f-mono">
            Môi trường QEMU tuỳ biến để giải lập hoàn chỉnh chip vi điều khiển ARM Cortex-M7 của thiết bị bay không người lái, cho phép dump RAM và trace lệnh real-time khi xảy ra sự cố.
          </p>
          <div class="mission-card__tags f-mono">
            <span>C++20</span>
            <span>QEMU</span>
            <span>GHIDRA</span>
            <span>ARM CORTEX</span>
          </div>
          <div class="mission-card__footer">
            <a href="https://github.com/logkism" target="_blank" rel="noopener" class="btn btn--sm btn--ghost" data-cursor="CODE">
              <span class="btn__tab"></span>
              <span class="btn__fill"></span>
              <span class="btn__label">SOURCE REPO ↗</span>
            </a>
            <a href={BLOG_URL} class="link-slash f-mono" data-warp="BLACKBOX WRITEUP">
              <span>ĐỌC BÀI VIẾT PHÂN TÍCH KỸ THUẬT</span>
            </a>
          </div>
        </article>

        <!-- Mission 3 -->
        <article class="mission-card panel brackets" data-reveal="0.3">
          <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
          <div class="mission-card__header">
            <span class="micro accent">MISSION CODENAME: RADAR-SHIELD</span>
            <span class="micro">CLASS: SECURE TELEMETRY PIPELINE</span>
          </div>
          <h3 class="f-display mission-card__title">RADAR TELEMETRY STREAM ENCRYPTION ENGINE</h3>
          <p class="mission-card__desc f-mono">
            Engine mã hoá thời gian thực cho dữ liệu radar mặt đất, thông lượng >10 Gbps với thuật toán Kyber hậu lượng tử (Post-Quantum Cryptography).
          </p>
          <div class="mission-card__tags f-mono">
            <span>RUST</span>
            <span>POST-QUANTUM CRYPTO</span>
            <span>HIGH-THROUGHPUT</span>
          </div>
          <div class="mission-card__footer">
            <a href="https://github.com/logkism" target="_blank" rel="noopener" class="btn btn--sm btn--ghost" data-cursor="CODE">
              <span class="btn__tab"></span>
              <span class="btn__fill"></span>
              <span class="btn__label">SOURCE REPO ↗</span>
            </a>
            <a href={BLOG_URL} class="link-slash f-mono" data-warp="BLACKBOX WRITEUP">
              <span>ĐỌC BÀI VIẾT PHÂN TÍCH KỸ THUẬT</span>
            </a>
          </div>
        </article>
      </div>
    </section>

    <!-- SECTION 04: FLIGHT LOG (TIMELINE) -->
    <section class="section wrap" id="flightlog">
      <div class="sec-head">
        <span class="sec-head__idx">04 //</span>
        <div class="sec-head__rule"></div>
        <span class="sec-head__tag t-cyber">CHRONOLOGY</span>
        <span class="sec-head__tag t-xian cjk">Tu Hành Niên Biểu</span>
      </div>

      <h2 class="sec-title">
        FLIGHT // <em>LOG</em>
      </h2>

      <div class="timeline">
        <div class="timeline-item" data-reveal="0.1">
          <div class="timeline-year f-display accent">2026 — PRESENT</div>
          <div class="timeline-content panel">
            <h3 class="f-head">LEAD AEROSPACE SECURITY RESEARCHER</h3>
            <span class="micro text-muted">ORBITAL CYBERNETICS LAB</span>
            <p class="f-mono text-muted">Chỉ huy các chiến dịch đánh giá an ninh giao thức vệ tinh quỹ đạo tầm trung (MEO) và xây dựng kiến trúc zero-trust cho trạm điều khiển mặt đất.</p>
          </div>
        </div>

        <div class="timeline-item" data-reveal="0.2">
          <div class="timeline-year f-display accent">2024 — 2026</div>
          <div class="timeline-content panel">
            <h3 class="f-head">EMBEDDED FIRMWARE EXPLOIT DEV</h3>
            <span class="micro text-muted">DEFENSE AVIONICS UNIT</span>
            <p class="f-mono text-muted">Phát hiện và báo cáo 12+ lỗ hổng bảo mật nghiêm trọng trong firmware cảm biến điều hướng máy bay không người lái.</p>
          </div>
        </div>

        <div class="timeline-item" data-reveal="0.3">
          <div class="timeline-year f-display accent">2022 — 2024</div>
          <div class="timeline-content panel">
            <h3 class="f-head">HARDWARE SECURITY & CTF PLAYER</h3>
            <span class="micro text-muted">GLOBAL RED TEAM COMPETITIONS</span>
            <p class="f-mono text-muted">Vô địch nhiều giải đấu CTF chuyên đề Hardware Hacking và Radio Frequency Reverse Engineering.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 05: CONTACT & WARP PORTAL -->
    <section class="section wrap" id="contact">
      <div class="sec-head">
        <span class="sec-head__idx">05 //</span>
        <div class="sec-head__rule"></div>
        <span class="sec-head__tag t-cyber">SECURE TRANSMISSION</span>
        <span class="sec-head__tag t-xian cjk">Vạn Lý Truyền Âm</span>
      </div>

      <div class="contact-box panel brackets" data-reveal="0.1">
        <i class="bk"></i><i class="bk"></i><i class="bk"></i><i class="bk"></i>
        <h2 class="f-display contact-title">
          OPEN DIRECT // <em>CHANNEL</em>
        </h2>
        <p class="f-mono contact-desc">
          Kênh liên lạc được mã hoá end-to-end. Sẵn sàng cho các dự án hợp tác nghiên cứu bảo mật hàng không vũ trụ, kiểm thử xâm nhập hạ tầng vệ tinh hoặc thỉnh giáo đạo pháp tu tiên.
        </p>
        <div class="contact-actions">
          <a href="mailto:contact@logkism.io" class="btn btn--primary" data-cursor="TRANSMIT">
            <span class="btn__tab"></span>
            <span class="btn__fill"></span>
            <span class="btn__label">TRANSMIT ENCRYPTED SIGNAL ✉</span>
          </a>
          <a href={BLOG_URL} class="btn-orb" data-warp="BLACKBOX BLOG" data-cursor="WARP">
            <div class="btn-orb__label">
              <span>GHÉ THĂM BLOG BLACKBOX</span>
            </div>
            <div class="btn-orb__ring">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 12L12 4M12 4H6M12 4V10"/>
              </svg>
            </div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <HudFooter />
</BaseLayout>

<style>
  /* HERO STYLES */
  .hero {
    min-height: 90svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: calc(var(--hud-h) + 3rem);
    padding-bottom: 4rem;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.4rem 1rem;
    background: rgba(193, 18, 31, 0.12);
    border: 1px solid var(--line-accent);
    width: fit-content;
    margin-bottom: 2rem;
  }
  .hero__title {
    font-size: var(--fs-hero);
    line-height: 0.9;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
  }
  .hero__line {
    display: inline-block;
  }
  .hero__lead {
    max-width: 68ch;
    font-size: var(--fs-lg);
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 3rem;
  }
  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 4.5rem;
  }
  .hero__hud-panel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    padding: 2.2rem;
    background: rgba(13, 13, 17, 0.7);
  }
  .hero__metric {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .hero__val {
    font-size: clamp(2rem, 3.5vw, 3rem);
    color: var(--fg);
    line-height: 1;
  }
  .text-ok { color: var(--ok); }
  .text-accent { color: var(--accent-hi); }
  .text-muted { color: var(--muted); }

  /* DOSSIER SECTION */
  .dossier-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2.5rem;
  }
  @media (max-width: 860px) {
    .dossier-grid { grid-template-columns: 1fr; }
  }
  .dossier-card {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    background: rgba(13, 13, 17, 0.6);
  }
  .dossier-name {
    font-size: 2.4rem;
    letter-spacing: 0.1em;
    color: var(--fg);
  }
  .redacted-box {
    margin-top: 1rem;
    padding: 1rem;
    background: rgba(193, 18, 31, 0.08);
    border-left: 2px solid var(--accent-hi);
  }
  .redacted-text {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    background: #000;
    color: #000;
    padding: 2px 6px;
    user-select: none;
    transition: all 0.3s;
    cursor: help;
  }
  .redacted-text:hover {
    background: transparent;
    color: var(--accent-hi);
  }
  .dossier-intel {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    gap: 1.5rem;
    background: rgba(22, 22, 28, 0.5);
  }
  .intel-row {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border-bottom: 1px dashed var(--line);
    padding-bottom: 0.8rem;
  }

  /* ARSENAL GRID */
  .arsenal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }
  .arsenal-card {
    padding: 2.2rem;
    background: rgba(13, 13, 17, 0.6);
  }
  .arsenal-card__title {
    font-size: 1.4rem;
    margin-block: 0.8rem 1.6rem;
    letter-spacing: 0.08em;
  }
  .arsenal-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: var(--fs-xs);
  }
  .arsenal-list li {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.5rem;
  }

  /* MISSIONS LIST */
  .missions-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .mission-card {
    padding: 2.5rem;
    background: rgba(13, 13, 17, 0.65);
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .mission-card__header {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .mission-card__title {
    font-size: 1.8rem;
    letter-spacing: 0.05em;
    color: var(--fg);
  }
  .mission-card__desc {
    color: var(--muted);
    font-size: var(--fs-sm);
